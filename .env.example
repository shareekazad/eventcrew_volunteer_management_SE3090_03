# EventCrew Environment Variables Example
# Copy this file to .env and customize for your local setup

# JWT Configuration
# Required: Secret key for signing and verifying JWT tokens (minimum 32 characters / 256 bits)
JWT_KEY=YourSuperSecretKeyForEventCrewThatIsAtLeast32Chars!

# Database Configuration
# Default PostgreSQL port for team consistency (override to 5433 locally if needed)
POSTGRES_PORT=5432
