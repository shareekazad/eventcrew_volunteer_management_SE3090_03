# ????????????????????????????????????????????????????????????????????????????
# EventCrew ASP.NET Core API ? Production Dockerfile
# Multi-stage: build in SDK image, run in slim runtime image
# ????????????????????????????????????????????????????????????????????????????

# ?? Stage 1: Build ??????????????????????????????????????????????????????????
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY src/EventCrew.Api/EventCrew.Api.csproj src/EventCrew.Api/
COPY src/EventCrew.Domain/EventCrew.Domain.csproj src/EventCrew.Domain/
COPY src/EventCrew.Infrastructure/EventCrew.Infrastructure.csproj src/EventCrew.Infrastructure/

RUN dotnet restore src/EventCrew.Api/EventCrew.Api.csproj

COPY src/ src/

WORKDIR /src/src/EventCrew.Api
RUN dotnet publish -c Release -o /app/publish /p:UseAppHost=false

# ?? Stage 2: Runtime ????????????????????????????????????????????????????????
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app

COPY --from=build /app/publish .

ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production

EXPOSE 8080

ENTRYPOINT ["dotnet", "EventCrew.Api.dll"]